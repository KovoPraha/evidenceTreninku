Options -Indexes

<FilesMatch "(^\.|\.sql$|\.log$|\.zip$|\.bak$|\.old$|\.php3$|composer\.(json|lock)$|CLAUDE\.md$|INSTALACE\.txt$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Produkcni prihlaseni ani jina stranka nesmi byt obslouzena pres HTTP.
    # Pevny kanonicky host zabranuje Host-header redirectu a podminka hostu
    # ponechava lokalni XAMPP vyvoj beze zmeny.
    RewriteCond %{HTTP_HOST} ^kis\.kovopraha\.cz(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://kis.kovopraha.cz%{REQUEST_URI} [R=308,L,NE]

    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^(?:bin|database|docs|migrations|tests|var|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^uploads/(?:uctenky|zatezove_testy|servis|temp)(?:/|$) - [F,L,NC]
    RewriteRule ^nahrane_zavody/results(?:/|$) - [F,L,NC]
    RewriteRule ^(?:test|analyze_excel|analyze_uci_form)\.php$ - [F,L,NC]
    # Upload directories may contain only passive media/documents. Block every
    # executable or browser-active suffix, not only PHP variants.
    RewriteRule ^(?:uploads|nahrane_obrazky|nahrane_zavody|stories|loga_story)/.*\.(?:php[0-9]?|phtml|pht|phtm|phar|html?|xhtml|shtml|svg|xml|js|mjs|wasm|cgi|pl|py|sh|htaccess)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # CSP for PHP pages is emitted with a per-response nonce by
    # includes/session_security.php. Static upload paths are restricted by the
    # active-extension deny rule above.
</IfModule>
