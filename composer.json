{
    "name": "moje/aplikace",
    "description": "Evidence tréninků Kovo Praha",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-libxml": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "phpoffice/phpspreadsheet": "^5.3",
        "minishlink/web-push": "^9.0",
        "endroid/qr-code": "^6.0",
        "stripe/stripe-php": "^21.1",
        "dompdf/dompdf": "^3.1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test:unit": "@php vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite unit",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "style:check": "@php tools/check-php-style.php",
        "style:fix": "@php tools/check-php-style.php --fix"
    }
}
